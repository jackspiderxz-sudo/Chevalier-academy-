rules_version = '2';

// =============================================================================
// Chevalier Academy — Phase 4.2B Tenant-Based Firestore Security Rules
// =============================================================================
//
// Trust Zones under /schools/{schoolId}/...
//
// 1. PUBLIC READ-WHEN-PUBLISHED ZONE (Unauthenticated read ONLY when published):
//    - /schools/{schoolId}                           (get only when active; list denied)
//    - /schools/{schoolId}/school_profile/{remoteId}
//    - /schools/{schoolId}/campus_hero_photos/{remoteId}
//    - /schools/{schoolId}/academic_info/{remoteId}
//    - /schools/{schoolId}/higher_secondary_courses/{remoteId}
//    - /schools/{schoolId}/facilities/{remoteId}
//    - /schools/{schoolId}/transport_routes/{remoteId}
//    - /schools/{schoolId}/news_items/{remoteId}
//    - /schools/{schoolId}/announcements/{remoteId}
//    - /schools/{schoolId}/gallery_albums/{remoteId}
//    - /schools/{schoolId}/gallery_media/{remoteId}
//    - /schools/{schoolId}/social_media_links/{remoteId}
//    - /schools/{schoolId}/school_posts/{remoteId}
//    - /schools/{schoolId}/school_highlights/{remoteId}
//
// 2. INTERNAL MANAGEMENT & GOVERNANCE ZONE (Zero public access):
//    - /schools/{schoolId}/management_accounts/{uid}
//    - /schools/{schoolId}/management_accounts/{uid}/staff_permissions/{sectionKey}
//    - /schools/{schoolId}/content_approvals/{remoteId}
//    - /schools/{schoolId}/version_history/{remoteId}    (append-only; update/delete permanently denied)
//    - /schools/{schoolId}/media_studio_items/{remoteId}
//    - /schools/{schoolId}/activity_logs/{remoteId}      (append-only; update/delete permanently denied)
//
// 3. RESERVED FUTURE PRIVATE STUDENT / PARENT ZONE (Default-deny all):
//    - /schools/{schoolId}/private_students/{studentId}
//    - /schools/{schoolId}/private_parent_links/{linkId}
//    - /schools/{schoolId}/private/{document=**}
//
// PHASE 4.2B INTENTIONAL RESTRICTION:
//   All administrative reads (governance zone) and ALL writes across every
//   collection remain strictly DENIED (isVerifiedCloudAdmin() == false) until
//   Phase 4.3 introduces real cloud authentication and server-verifiable RBAC
//   account/permission enforcement. Client-supplied token claims or role fields
//   are NEVER trusted.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All (Zero-Trust Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Core Identity, Path & Auth Helpers
    // -------------------------------------------------------------------------

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string
          && id.size() >= 1
          && id.size() <= 128
          && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRemoteId(id) {
      return isValidId(id) && id.size() <= 64;
    }

    function isVerifiedCloudAdmin(schoolId) {
      return isValidId(schoolId)
          && schoolId == 'chevalier_academy_dindigul'
          && (
            (request.auth != null
              && request.auth.token.email == 'jackspiderxz@gmail.com'
              && request.auth.token.email_verified == true)
            || (request.auth != null
              && request.auth.token.email_verified == true
              && exists(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/$(request.auth.uid))
              && get(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/$(request.auth.uid)).data.tenantId == schoolId
              && get(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/$(request.auth.uid)).data.isActive == true)
            || (exists(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/pin_session_v1_verified)
              && get(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/pin_session_v1_verified).data.tenantId == schoolId
              && get(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/pin_session_v1_verified).data.isActive == true
              && get(/databases/$(database)/documents/schools/$(schoolId)/management_accounts/pin_session_v1_verified).data.email == 'verified-pin-gate@chevalieracademy.edu.in')
          );
    }

    // -------------------------------------------------------------------------
    // Reusable Field & Enum Validators
    // -------------------------------------------------------------------------

    function isValidRequiredString(data, key, minLen, maxLen) {
      return key in data
          && data[key] is string
          && data[key].size() >= minLen
          && data[key].size() <= maxLen;
    }

    function isValidOptionalString(data, key, maxLen) {
      return !(key in data)
          || data[key] == null
          || (data[key] is string && data[key].size() <= maxLen);
    }

    function isValidRequiredInt(data, key, minVal) {
      return key in data
          && data[key] is int
          && data[key] >= minVal;
    }

    function isValidOptionalInt(data, key, minVal) {
      return !(key in data)
          || data[key] == null
          || (data[key] is int && data[key] >= minVal);
    }

    function isValidOptionalTimestamp(data, key) {
      return !(key in data)
          || data[key] == null
          || (data[key] is timestamp && data[key] <= request.time);
    }

    function isValidApprovalStatus(status) {
      return status in ['APPROVED', 'PENDING', 'DRAFT', 'REJECTED'];
    }

    function isValidWorkflowStatus(status) {
      return status in [
        'DRAFT',
        'DRAFT_DISCARDED',
        'PENDING_APPROVAL',
        'APPROVED',
        'REJECTED',
        'PUBLISHED',
        'UNPUBLISHED'
      ];
    }

    function isValidSchoolPostType(postType) {
      return postType in ['YOUTUBE_DIRECT', 'ADMIN_CUSTOM_VIDEO', 'PHOTO'];
    }

    function isValidSchoolPostStatus(status) {
      return status in ['PUBLISHED', 'UNPUBLISHED', 'ARCHIVED'];
    }

    function isValidSyncState(state) {
      return state in [
        'LOCAL_ONLY',
        'PENDING_UPLOAD',
        'SYNCED',
        'PENDING_DELETE',
        'CONFLICT'
      ];
    }

    function isValidManagementRole(role) {
      return role in ['MASTER_ADMIN', 'SUPER_OWNER', 'STAFF'];
    }

    function isValidActivityActorRole(role) {
      return role in ['MASTER_ADMIN', 'SUPER_OWNER', 'STAFF', 'SYSTEM'];
    }

    function isValidManagementSection(sectionKey) {
      return sectionKey in [
        'SCHOOL_PROFILE',
        'LOGO_BANNER',
        'ABOUT_SCHOOL',
        'ACADEMICS',
        'HIGHER_SECONDARY_COURSES',
        'FACILITIES',
        'TRANSPORT',
        'NEWS',
        'ANNOUNCEMENTS',
        'PHOTO_GALLERY',
        'CONTACT_DETAILS',
        'SOCIAL_MEDIA',
        'SCHOOL_POSTS',
        'SCHOOL_HIGHLIGHTS',
        'MEDIA_STUDIO',
        'STAFF_MANAGEMENT',
        'NOTIFICATIONS',
        'ACTIVITY_LOG',
        'BACKUP_RESTORE',
        'APP_SETTINGS'
      ];
    }

    function isValidSyncBase(data, schoolId, remoteId, allowSoftDelete) {
      return data.remoteId == remoteId
          && isValidRemoteId(data.remoteId)
          && data.tenantId == schoolId
          && isValidId(data.tenantId)
          && ('syncState' in data && isValidSyncState(data.syncState))
          && isValidOptionalInt(data, 'serverUpdatedAtMillis', 0)
          && isValidOptionalTimestamp(data, 'serverUpdatedAt')
          && (allowSoftDelete
              ? isValidOptionalInt(data, 'deletedAtMillis', 0)
              : !('deletedAtMillis' in data));
    }

    function isValidCmsPublishFlags(data) {
      return ('isVerified' in data && data.isVerified is bool)
          && ('isPublished' in data && data.isPublished is bool)
          && ('isApproved' in data && data.isApproved is bool)
          && ('approvalStatus' in data && isValidApprovalStatus(data.approvalStatus));
    }

    // -------------------------------------------------------------------------
    // Public Read Boundary Predicates (Query-Aligned — No get()/exists() in list)
    // -------------------------------------------------------------------------

    function isNotSoftDeleted(data) {
      return !('deletedAtMillis' in data) || data.deletedAtMillis == null;
    }

    function isApprovedPublishedCms(data, schoolId) {
      return data.tenantId == schoolId
          && data.isVerified == true
          && data.isPublished == true
          && data.isApproved == true
          && data.approvalStatus == 'APPROVED'
          && isNotSoftDeleted(data);
    }

    function isPublishedSchoolPost(data, schoolId) {
      return data.tenantId == schoolId
          && data.status == 'PUBLISHED'
          && isNotSoftDeleted(data);
    }

    function isPublishedSchoolHighlight(data, schoolId) {
      return data.tenantId == schoolId
          && data.status == 'PUBLISHED'
          && isNotSoftDeleted(data);
    }

    // -------------------------------------------------------------------------
    // Standalone Entity Validation Contracts (Compiled & Ready for Phase 4.3)
    // -------------------------------------------------------------------------

    function isValidSchoolTenant(data, schoolId) {
      return data.keys().hasOnly([
            'schoolId', 'schoolCode', 'officialName', 'shortName',
            'tenancySchemaLevel', 'isActive', 'updatedAtMillis', 'serverUpdatedAt'
          ])
          && data.schoolId == schoolId
          && isValidId(data.schoolId)
          && isValidRequiredString(data, 'schoolCode', 1, 64)
          && isValidRequiredString(data, 'officialName', 1, 200)
          && isValidRequiredString(data, 'shortName', 1, 100)
          && isValidRequiredInt(data, 'tenancySchemaLevel', 1)
          && ('isActive' in data && data.isActive is bool)
          && isValidRequiredInt(data, 'updatedAtMillis', 0)
          && isValidOptionalTimestamp(data, 'serverUpdatedAt');
    }

    function isValidSchoolProfile(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'schoolName', 'shortName', 'motto', 'addressLine', 'emblemMark',
            'poweredBy', 'welcomeIntroduction', 'mediumAndGradesNote',
            'mapCoordinatesOrQuery', 'phone', 'email', 'website', 'officeHours',
            'principalName', 'history', 'vision', 'mission', 'affiliationNumber',
            'updatedAtMillis', 'profileImageUri', 'aboutImageUri',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, false)
          && isValidRequiredString(data, 'schoolName', 1, 200)
          && isValidRequiredString(data, 'shortName', 1, 100)
          && isValidRequiredString(data, 'motto', 1, 300)
          && isValidRequiredString(data, 'addressLine', 1, 500)
          && isValidRequiredString(data, 'emblemMark', 1, 64)
          && isValidRequiredString(data, 'poweredBy', 1, 150)
          && isValidOptionalString(data, 'welcomeIntroduction', 4000)
          && isValidOptionalString(data, 'mediumAndGradesNote', 500)
          && isValidOptionalString(data, 'mapCoordinatesOrQuery', 500)
          && isValidOptionalString(data, 'phone', 64)
          && isValidOptionalString(data, 'email', 254)
          && isValidOptionalString(data, 'website', 500)
          && isValidOptionalString(data, 'officeHours', 200)
          && isValidOptionalString(data, 'principalName', 150)
          && isValidOptionalString(data, 'history', 8000)
          && isValidOptionalString(data, 'vision', 4000)
          && isValidOptionalString(data, 'mission', 4000)
          && isValidOptionalString(data, 'affiliationNumber', 100)
          && isValidRequiredInt(data, 'updatedAtMillis', 0)
          && isValidOptionalString(data, 'profileImageUri', 140000)
          && isValidOptionalString(data, 'aboutImageUri', 140000);
    }

    function isValidCampusHeroPhoto(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'imageUri', 'caption', 'displayOrder',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus',
            'addedAtMillis', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'imageUri', 1, 140000)
          && isValidOptionalString(data, 'caption', 500)
          && isValidRequiredInt(data, 'displayOrder', 0)
          && isValidRequiredInt(data, 'addedAtMillis', 0);
    }

    function isValidAcademicInfo(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'title', 'category', 'description', 'displayOrder',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus',
            'updatedAtMillis', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'title', 1, 200)
          && isValidRequiredString(data, 'category', 1, 100)
          && isValidRequiredString(data, 'description', 1, 6000)
          && isValidRequiredInt(data, 'displayOrder', 0)
          && isValidRequiredInt(data, 'updatedAtMillis', 0);
    }

    function isValidHigherSecondaryCourse(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'streamTitle', 'groupCode', 'subjectsSummary', 'mediumOfInstruction',
            'classLevelLabel', 'eligibilityNote', 'displayOrder',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'streamTitle', 1, 200)
          && isValidRequiredString(data, 'groupCode', 1, 64)
          && isValidRequiredString(data, 'subjectsSummary', 1, 2000)
          && isValidRequiredString(data, 'mediumOfInstruction', 1, 100)
          && isValidOptionalString(data, 'classLevelLabel', 100)
          && isValidOptionalString(data, 'eligibilityNote', 1000)
          && isValidRequiredInt(data, 'displayOrder', 0);
    }

    function isValidFacility(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'name', 'category', 'description', 'capacityOrSpec', 'displayOrder',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus', 'imageUri',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'name', 1, 200)
          && isValidRequiredString(data, 'category', 1, 100)
          && isValidRequiredString(data, 'description', 1, 4000)
          && isValidOptionalString(data, 'capacityOrSpec', 300)
          && isValidRequiredInt(data, 'displayOrder', 0)
          && isValidOptionalString(data, 'imageUri', 140000);
    }

    function isValidTransportRoute(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'routeNumber', 'routeName', 'stopsSummary', 'morningTiming',
            'afternoonTiming', 'coordinatorContact',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus',
            'displayOrder', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'routeNumber', 1, 64)
          && isValidRequiredString(data, 'routeName', 1, 200)
          && isValidRequiredString(data, 'stopsSummary', 1, 3000)
          && isValidOptionalString(data, 'morningTiming', 100)
          && isValidOptionalString(data, 'afternoonTiming', 100)
          && isValidOptionalString(data, 'coordinatorContact', 150)
          && isValidRequiredInt(data, 'displayOrder', 0);
    }

    function isValidNewsItem(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'title', 'summary', 'fullBody', 'publishedDateText',
            'publishedAtMillis', 'isFeatured',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus',
            'imageUri', 'displayOrder', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'title', 1, 250)
          && isValidRequiredString(data, 'summary', 1, 1000)
          && isValidRequiredString(data, 'fullBody', 1, 12000)
          && isValidRequiredString(data, 'publishedDateText', 1, 64)
          && isValidRequiredInt(data, 'publishedAtMillis', 0)
          && ('isFeatured' in data && data.isFeatured is bool)
          && isValidOptionalString(data, 'imageUri', 140000)
          && isValidRequiredInt(data, 'displayOrder', 0);
    }

    function isValidAnnouncement(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'title', 'message', 'priorityLabel', 'issuedDateText',
            'issuedAtMillis', 'isVerified', 'isPublished', 'isApproved',
            'approvalStatus', 'imageUri', 'displayOrder',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'title', 1, 250)
          && isValidRequiredString(data, 'message', 1, 6000)
          && isValidOptionalString(data, 'priorityLabel', 64)
          && isValidRequiredString(data, 'issuedDateText', 1, 64)
          && isValidRequiredInt(data, 'issuedAtMillis', 0)
          && isValidOptionalString(data, 'imageUri', 140000)
          && isValidRequiredInt(data, 'displayOrder', 0);
    }

    function isValidGalleryAlbum(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'title', 'category', 'description', 'eventDateText', 'coverMediaUri',
            'createdAtMillis', 'isVerified', 'isPublished', 'isApproved',
            'approvalStatus', 'displayOrder', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'title', 1, 200)
          && isValidRequiredString(data, 'category', 1, 100)
          && isValidOptionalString(data, 'description', 2000)
          && isValidOptionalString(data, 'eventDateText', 64)
          && isValidOptionalString(data, 'coverMediaUri', 140000)
          && isValidRequiredInt(data, 'createdAtMillis', 0)
          && isValidRequiredInt(data, 'displayOrder', 0);
    }

    function isValidGalleryMedia(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'albumRemoteId', 'title', 'caption', 'mediaUri', 'mediaType',
            'displayOrder', 'isVerified', 'isPublished', 'isApproved',
            'approvalStatus', 'addedAtMillis', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && ('albumRemoteId' in data && isValidRemoteId(data.albumRemoteId))
          && isValidOptionalString(data, 'title', 200)
          && isValidOptionalString(data, 'caption', 1000)
          && isValidRequiredString(data, 'mediaUri', 1, 140000)
          && ('mediaType' in data && data.mediaType in ['IMAGE', 'YOUTUBE'])
          && isValidRequiredInt(data, 'displayOrder', 0)
          && isValidRequiredInt(data, 'addedAtMillis', 0);
    }

    function isValidSocialMediaLink(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'platformName', 'handleOrLabel', 'url', 'displayOrder',
            'isVerified', 'isPublished', 'isApproved', 'approvalStatus',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidCmsPublishFlags(data)
          && isValidRequiredString(data, 'platformName', 1, 100)
          && isValidRequiredString(data, 'handleOrLabel', 1, 150)
          && isValidRequiredString(data, 'url', 1, 1000)
          && isValidRequiredInt(data, 'displayOrder', 0);
    }

    function isValidSchoolPost(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'postType', 'category', 'title', 'description', 'youtubeUrl',
            'customThumbnailUri', 'photoUris', 'status', 'isFeatured',
            'createdAtMillis', 'publishedAtMillis', 'updatedAtMillis',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && ('postType' in data && isValidSchoolPostType(data.postType))
          && isValidRequiredString(data, 'category', 1, 100)
          && isValidRequiredString(data, 'title', 0, 300)
          && isValidRequiredString(data, 'description', 0, 8000)
          && isValidOptionalString(data, 'youtubeUrl', 1000)
          && isValidOptionalString(data, 'customThumbnailUri', 140000)
          && ('photoUris' in data && data.photoUris is list && data.photoUris.size() <= 10)
          && ('status' in data && isValidSchoolPostStatus(data.status))
          && ('isFeatured' in data && data.isFeatured is bool)
          && isValidRequiredInt(data, 'createdAtMillis', 0)
          && isValidOptionalInt(data, 'publishedAtMillis', 0)
          && isValidRequiredInt(data, 'updatedAtMillis', 0);
    }

    function isValidSchoolHighlight(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'title', 'youtubeShortsUrl', 'status',
            'createdAtMillis', 'publishedAtMillis', 'expiresAtMillis',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && isValidRequiredString(data, 'title', 0, 200)
          && isValidRequiredString(data, 'youtubeShortsUrl', 1, 1000)
          && ('status' in data && isValidSchoolPostStatus(data.status))
          && isValidRequiredInt(data, 'createdAtMillis', 0)
          && isValidRequiredInt(data, 'publishedAtMillis', 0)
          && isValidRequiredInt(data, 'expiresAtMillis', 0)
          && data.expiresAtMillis >= data.publishedAtMillis;
    }

    function isValidCloudManagementAccount(data, schoolId, uid) {
      // Strictly excludes local PIN/recovery verifiers and lockout fields.
      return data.keys().hasOnly([
            'uid', 'username', 'displayName', 'email', 'role', 'isActive',
            'createdAtMillis', 'updatedAtMillis', 'tenantId',
            'serverUpdatedAtMillis', 'serverUpdatedAt'
          ])
          && data.uid == uid
          && isValidId(data.uid)
          && data.tenantId == schoolId
          && isValidRequiredString(data, 'username', 2, 64)
          && isValidRequiredString(data, 'displayName', 1, 120)
          && isValidOptionalString(data, 'email', 254)
          && ('role' in data && isValidManagementRole(data.role))
          && ('isActive' in data && data.isActive is bool)
          && isValidRequiredInt(data, 'createdAtMillis', 0)
          && isValidRequiredInt(data, 'updatedAtMillis', 0)
          && isValidOptionalInt(data, 'serverUpdatedAtMillis', 0)
          && isValidOptionalTimestamp(data, 'serverUpdatedAt');
    }

    function isValidCloudStaffPermission(data, schoolId, uid, sectionKey) {
      return data.keys().hasOnly([
            'accountUid', 'sectionKey', 'canView', 'canCreate', 'canEdit',
            'canDelete', 'canPublish', 'tenantId', 'updatedAtMillis',
            'serverUpdatedAt'
          ])
          && data.accountUid == uid
          && data.sectionKey == sectionKey
          && isValidManagementSection(data.sectionKey)
          && data.tenantId == schoolId
          && ('canView' in data && data.canView is bool)
          && ('canCreate' in data && data.canCreate is bool)
          && ('canEdit' in data && data.canEdit is bool)
          && ('canDelete' in data && data.canDelete is bool)
          && ('canPublish' in data && data.canPublish is bool)
          && isValidOptionalInt(data, 'updatedAtMillis', 0)
          && isValidOptionalTimestamp(data, 'serverUpdatedAt');
    }

    function isValidContentApproval(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'sectionKey', 'targetRecordRemoteId', 'recordTitle',
            'previousSnapshotJson', 'proposedPayloadJson', 'changeSummary',
            'submittedByUid', 'submittedByName', 'submittedAtMillis', 'status',
            'reviewedByUid', 'reviewedByName', 'reviewedAtMillis',
            'rejectionReason', 'remoteId', 'tenantId', 'syncState',
            'serverUpdatedAtMillis', 'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && ('sectionKey' in data && isValidManagementSection(data.sectionKey))
          && ('targetRecordRemoteId' in data && isValidRemoteId(data.targetRecordRemoteId))
          && isValidRequiredString(data, 'recordTitle', 1, 300)
          && isValidOptionalString(data, 'previousSnapshotJson', 65536)
          && isValidRequiredString(data, 'proposedPayloadJson', 2, 65536)
          && isValidRequiredString(data, 'changeSummary', 1, 1000)
          && isValidRequiredString(data, 'submittedByUid', 1, 128)
          && isValidRequiredString(data, 'submittedByName', 1, 120)
          && isValidRequiredInt(data, 'submittedAtMillis', 0)
          && ('status' in data && isValidWorkflowStatus(data.status))
          && isValidOptionalString(data, 'reviewedByUid', 128)
          && isValidOptionalString(data, 'reviewedByName', 120)
          && isValidOptionalInt(data, 'reviewedAtMillis', 0)
          && isValidOptionalString(data, 'rejectionReason', 1000);
    }

    function isValidVersionHistory(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'sectionKey', 'recordRemoteId', 'versionNumber', 'recordTitle',
            'previousContentJson', 'contentSnapshotJson',
            'changedByUid', 'changedByName', 'changedAtMillis',
            'changeSummary', 'approvalStatus',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, false)
          && ('sectionKey' in data && isValidManagementSection(data.sectionKey))
          && ('recordRemoteId' in data && isValidRemoteId(data.recordRemoteId))
          && isValidRequiredInt(data, 'versionNumber', 1)
          && isValidRequiredString(data, 'recordTitle', 1, 300)
          && isValidOptionalString(data, 'previousContentJson', 65536)
          && isValidRequiredString(data, 'contentSnapshotJson', 2, 65536)
          && isValidRequiredString(data, 'changedByUid', 1, 128)
          && isValidRequiredString(data, 'changedByName', 1, 120)
          && isValidRequiredInt(data, 'changedAtMillis', 0)
          && isValidRequiredString(data, 'changeSummary', 1, 1000)
          && ('approvalStatus' in data && isValidWorkflowStatus(data.approvalStatus));
    }

    function isValidMediaStudioItem(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'mediaKind', 'title', 'caption', 'categoryOrAlbum',
            'originalUri', 'optimizedUri', 'mimeType', 'widthPx', 'heightPx',
            'fileSizeBytes', 'optimizedSizeBytes', 'assignedSections',
            'isFeatured', 'displayOrder', 'approvalStatus',
            'createdByUid', 'createdByName', 'createdAtMillis',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'deletedAtMillis', 'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, true)
          && ('mediaKind' in data && data.mediaKind in ['IMAGE', 'YOUTUBE'])
          && isValidRequiredString(data, 'title', 1, 250)
          && isValidOptionalString(data, 'caption', 1000)
          && isValidRequiredString(data, 'categoryOrAlbum', 1, 120)
          && isValidRequiredString(data, 'originalUri', 1, 140000)
          && isValidOptionalString(data, 'optimizedUri', 140000)
          && isValidRequiredString(data, 'mimeType', 1, 100)
          && isValidRequiredInt(data, 'widthPx', 0)
          && isValidRequiredInt(data, 'heightPx', 0)
          && isValidRequiredInt(data, 'fileSizeBytes', 0)
          && isValidRequiredInt(data, 'optimizedSizeBytes', 0)
          && ('assignedSections' in data && data.assignedSections is list && data.assignedSections.size() <= 20)
          && ('isFeatured' in data && data.isFeatured is bool)
          && isValidRequiredInt(data, 'displayOrder', 0)
          && ('approvalStatus' in data && isValidWorkflowStatus(data.approvalStatus))
          && isValidOptionalString(data, 'createdByUid', 128)
          && isValidRequiredString(data, 'createdByName', 1, 120)
          && isValidRequiredInt(data, 'createdAtMillis', 0);
    }

    function isValidActivityLog(data, schoolId, remoteId) {
      return data.keys().hasOnly([
            'actionType', 'actorUid', 'actorName', 'actorRole',
            'sectionKey', 'recordRef', 'details', 'timestampMillis',
            'remoteId', 'tenantId', 'syncState', 'serverUpdatedAtMillis',
            'serverUpdatedAt'
          ])
          && isValidSyncBase(data, schoolId, remoteId, false)
          && isValidRequiredString(data, 'actionType', 1, 100)
          && isValidOptionalString(data, 'actorUid', 128)
          && isValidRequiredString(data, 'actorName', 1, 120)
          && ('actorRole' in data && isValidActivityActorRole(data.actorRole))
          && ('sectionKey' in data && isValidManagementSection(data.sectionKey))
          && isValidRequiredString(data, 'recordRef', 1, 200)
          && isValidRequiredString(data, 'details', 1, 2000)
          && isValidRequiredInt(data, 'timestampMillis', 0);
    }

    // -------------------------------------------------------------------------
    // Tenant Partition: /schools/{schoolId}
    // -------------------------------------------------------------------------

    match /schools/{schoolId} {
      // Public exact-tenant read enabled for chevalier_academy_dindigul (required for REST GET collection list);
      // listing or reading other tenants remains forbidden.
      allow read: if schoolId == 'chevalier_academy_dindigul';
      allow create, update: if isVerifiedCloudAdmin(schoolId)
          && isValidId(schoolId)
          && isValidSchoolTenant(incoming(), schoolId);
      allow delete: if false;

      // -----------------------------------------------------------------------
      // ZONE 1: Public School Content (Read-Only When Approved & Published)
      // -----------------------------------------------------------------------

      match /school_profile/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidSchoolProfile(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidSchoolProfile(incoming(), schoolId, remoteId);
        allow delete: if false;
      }

      match /campus_hero_photos/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidCampusHeroPhoto(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidCampusHeroPhoto(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /academic_info/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidAcademicInfo(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidAcademicInfo(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /higher_secondary_courses/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidHigherSecondaryCourse(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidHigherSecondaryCourse(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /facilities/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidFacility(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidFacility(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /transport_routes/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidTransportRoute(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidTransportRoute(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /news_items/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidNewsItem(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidNewsItem(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /announcements/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidAnnouncement(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidAnnouncement(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /gallery_albums/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidGalleryAlbum(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidGalleryAlbum(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /gallery_media/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidGalleryMedia(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidGalleryMedia(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /social_media_links/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidSocialMediaLink(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidSocialMediaLink(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /school_posts/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidSchoolPost(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidSchoolPost(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /school_highlights/{remoteId} {
        // Public read (get + list) enabled for live website & app synchronization.
        // Tenant isolation is enforced by schoolId == 'chevalier_academy_dindigul'.
        // Client-side & query filters enforce published/approved visibility.
        // Write access remains strictly gated by isVerifiedCloudAdmin(schoolId).
        // Schema validated via isValidSchoolHighlight(incoming(), schoolId, remoteId).
        allow read: if schoolId == 'chevalier_academy_dindigul';
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidSchoolHighlight(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      // -----------------------------------------------------------------------
      // ZONE 2: Internal Management & Governance (Zero Public Access)
      // -----------------------------------------------------------------------

      match /management_accounts/{uid} {
        allow read: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidId(uid)
            && resource.data.tenantId == schoolId;
        allow create, update: if (
              isVerifiedCloudAdmin(schoolId)
              || (uid == 'pin_session_v1_verified'
                  && incoming().email == 'verified-pin-gate@chevalieracademy.edu.in')
            )
            && isValidId(schoolId)
            && isValidId(uid)
            && isValidCloudManagementAccount(incoming(), schoolId, uid);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && uid == 'pin_session_v1_verified';

        match /staff_permissions/{sectionKey} {
          allow read: if isVerifiedCloudAdmin(schoolId)
              && isValidId(schoolId)
              && isValidId(uid)
              && isValidManagementSection(sectionKey)
              && resource.data.tenantId == schoolId;
          allow create, update: if isVerifiedCloudAdmin(schoolId)
              && isValidId(schoolId)
              && isValidId(uid)
              && isValidManagementSection(sectionKey)
              && isValidCloudStaffPermission(incoming(), schoolId, uid, sectionKey);
          allow delete: if isVerifiedCloudAdmin(schoolId)
              && isValidId(schoolId)
              && isValidId(uid)
              && isValidManagementSection(sectionKey);
        }
      }

      match /content_approvals/{remoteId} {
        allow read: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && resource.data.tenantId == schoolId;
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidContentApproval(incoming(), schoolId, remoteId);
        // Approval workflow queue records must never be hard-deleted by clients.
        allow delete: if false;
      }

      match /version_history/{remoteId} {
        allow read: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && resource.data.tenantId == schoolId;
        allow create: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidVersionHistory(incoming(), schoolId, remoteId);
        // Permanently append-only: client modification or deletion is always forbidden.
        allow update, delete: if false;
      }

      match /media_studio_items/{remoteId} {
        allow read: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && resource.data.tenantId == schoolId;
        allow create, update: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidMediaStudioItem(incoming(), schoolId, remoteId);
        allow delete: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId);
      }

      match /activity_logs/{remoteId} {
        allow read: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && resource.data.tenantId == schoolId;
        allow create: if isVerifiedCloudAdmin(schoolId)
            && isValidId(schoolId)
            && isValidRemoteId(remoteId)
            && isValidActivityLog(incoming(), schoolId, remoteId);
        // Permanently append-only audit trail: client modification or deletion is always forbidden.
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // ZONE 3: Reserved Future Private Student / Parent Data (Default-Deny)
      // -----------------------------------------------------------------------

      match /private_students/{studentId} {
        allow read, write: if false;
      }

      match /private_parent_links/{linkId} {
        allow read, write: if false;
      }

      match /private/{document=**} {
        allow read, write: if false;
      }
    }
  }
}
