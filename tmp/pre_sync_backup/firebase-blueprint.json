{
  "entities": {
    "SchoolTenant": {
      "title": "SchoolTenant",
      "description": "Root multi-tenant descriptor matching SchoolTenantDescriptor / SchoolTenantContext (e.g., chevalier_academy_dindigul). Publicly readable by exact schoolId only when active; non-listable.",
      "type": "object",
      "properties": {
        "schoolId": {
          "type": "string",
          "description": "Canonical tenant identifier matching document ID (e.g., chevalier_academy_dindigul)."
        },
        "schoolCode": {
          "type": "string",
          "description": "Short school code (e.g., CAMHSS-DGL)."
        },
        "officialName": {
          "type": "string",
          "description": "Official school name."
        },
        "shortName": {
          "type": "string",
          "description": "Short display name."
        },
        "tenancySchemaLevel": {
          "type": "integer",
          "description": "Schema partitioning version matching SchoolTenantContext.TENANCY_SCHEMA_LEVEL."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether this tenant is active for public read access."
        },
        "updatedAtMillis": {
          "type": "integer",
          "description": "Last update epoch milliseconds."
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Firestore server timestamp of last cloud update."
        }
      },
      "required": [
        "schoolId",
        "schoolCode",
        "officialName",
        "shortName",
        "tenancySchemaLevel",
        "isActive",
        "updatedAtMillis"
      ]
    },
